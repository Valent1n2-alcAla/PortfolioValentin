APP_ENV=dev
APP_DEBUG=true
APP_SECRET=change_me_with_a_random_32char_string

###> doctrine/doctrine-bundle ###
# Remplace DB_USER et DB_PASSWORD par tes accès MariaDB
DATABASE_URL="mysql://DB_USER:DB_PASSWORD@127.0.0.1:3306/portfolio_contact?serverVersion=10.11.2-MariaDB&charset=utf8mb4"
###< doctrine/doctrine-bundle ###

###> symfony/mailer ###
#
# ── Option 1 : Mailtrap (tests locaux) ───────────────────────────────────────
# Crée un compte sur https://mailtrap.io → Inboxes → SMTP Settings
# MAILER_DSN=smtp://USERNAME:PASSWORD@sandbox.smtp.mailtrap.io:2525
#
# ── Option 2 : Gmail (production) ────────────────────────────────────────────
# Active "Mots de passe des applications" dans ton compte Google
# MAILER_DSN=gmail+smtp://alcalavalentin55@gmail.com:APP_PASSWORD@default
#
# ── Option 3 : SMTP custom ───────────────────────────────────────────────────
# MAILER_DSN=smtp://USER:PASSWORD@smtp.monhébergeur.fr:587
#
MAILER_DSN=smtp://localhost:1025

# Expéditeur système affiché dans le mail
MAILER_FROM=noreply@portfolio-valentin.fr

# Adresse où tu veux recevoir les alertes
MAILER_TO=alcalavalentin55@gmail.com
###< symfony/mailer ###

CORS_ALLOW_ORIGIN=http://localhost:5173
